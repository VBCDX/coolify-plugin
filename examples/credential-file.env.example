# Example Coolify credential file for @vbcdx/coolify-plugin.
#
# Copy this to a private location, fill in a real token, and pass its ABSOLUTE
# path as the `credential_file` argument on every tool call (except `health`).
#
# Required permissions on disk (POSIX, enforced at call time):
#   - a regular, non-symlink file owned by you, mode 0600
#   - in an immediate parent directory owned by you, mode 0700
#   - no symlink component anywhere in the path
#
#   install -d -m 700 ~/.config/vbcdx/coolify
#   install -m 600 /dev/null ~/.config/vbcdx/coolify/devops-agent.env
#   $EDITOR ~/.config/vbcdx/coolify/devops-agent.env
#
# Grammar (shared with the dev-agents spec): blank lines and lines whose first
# non-whitespace character is '#' are ignored; assignments split at the first '=';
# key and value are trimmed. Unquoted interior spaces, '#', '=', and '$' are
# literal. Single-quoted values are literal; double-quoted values use JSON string
# escaping.

# Descriptive only — conveys no authority. Use the canonical agent id.
VBCDX_AGENTS_ROLE=devops-agent

# The Coolify API token, sent as `Authorization: Bearer <token>`. Coolify has no
# password fallback. Provision a token scoped to only the permissions the role
# needs (read, read:sensitive, write, deploy). A deploy-only token is legitimate.
VBCDX_AGENTS_TOKEN=replace-with-a-real-coolify-api-token

# VBCDX_AGENTS_USER and VBCDX_AGENTS_PASSWORD may be present under the shared
# format but are ignored by Coolify authentication.
