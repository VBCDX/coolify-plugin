# Every environment variable @vbcdx/coolify-plugin reads. None of them is a secret:
# the Coolify API token comes from the credential file (stdio `mcp`) or the
# per-request Authorization header (`serve`), never from the environment.

# Coolify instance URL. Required for any API call. A trailing /api/v1 is accepted.
VBCDX_COOLIFY_URL=https://coolify.example
# off (default) = reads only; write = config/deploy writes; full = also destructive tools.
VBCDX_COOLIFY_WRITES=off
# Total per-call budget in ms, 1000-120000.
VBCDX_COOLIFY_TIMEOUT_MS=30000

# serve (network mode) only
VBCDX_COOLIFY_HTTP_PORT=8080
# Bind address: default 127.0.0.1 (loopback only); the Docker image sets 0.0.0.0.
# VBCDX_COOLIFY_HTTP_HOST=0.0.0.0
# HTTPS directly: both or neither (paths to PEM files).
VBCDX_COOLIFY_TLS_CERT=
VBCDX_COOLIFY_TLS_KEY=
# Browser origins allowed to call serve (comma-separated scheme://host[:port]).
# Empty = none: any request carrying an Origin header gets 403 (MCP transport
# DNS-rebinding rule; it protects POST /mcp, not a same-origin GET such as
# /healthz). No wildcards. Server-to-server MCP clients send no Origin.
VBCDX_COOLIFY_HTTP_ALLOWED_ORIGINS=
